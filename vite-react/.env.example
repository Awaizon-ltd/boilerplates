# Awarizon API key — get one at https://awarizon.com/dashboard/api-keys
VITE_AWARIZON_API_KEY=awz_live_...

# WalletConnect project ID — get one at https://cloud.walletconnect.com
VITE_WC_PROJECT_ID=your_walletconnect_project_id

# Target chain: base | ethereum | polygon | arbitrum | optimism | bsc | avalanche
VITE_CHAIN=base
