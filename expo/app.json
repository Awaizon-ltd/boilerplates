{
  "expo": {
    "name": "Awarizon Expo",
    "slug": "awarizon-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "awarizon",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a"
      }
    },
    "plugins": ["expo-router", "expo-secure-store"]
  }
}
